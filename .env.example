# =========================================================
# BHARAT STUDY BUDDY - ENVIRONMENT CONFIGURATION TEMPLATE
# =========================================================
# Copy this file to '.env' in the project root:
#   copy .env.example .env
# Fill in your own API keys. NEVER commit '.env' to git!
# =========================================================

# --- 1. AI PROVIDERS ---
# Groq Cloud API Key (Powers Ask AI RAG, Paper Analyzer AI, Guru Voice AI & Whisper STT)
# Get your free API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Google Gemini API Key (Powers Multimodal Diagram Explainer & Vision Analysis)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- 2. FLASK SERVER & SECURITY ---
# Secret key for encrypting session cookies (use a long random string)
FLASK_SECRET_KEY=your_super_secret_session_key_change_in_production

# --- 3. EMAIL OTP AUTHENTICATION (SIGNUP / LOGIN) ---
# Set to 'true' during local development to print OTP directly to backend terminal
OTP_DEV_MODE=true

# Option A: Gmail SMTP Configuration (Requires Google App Password)
# Guide: Google Account -> Security -> 2-Step Verification -> App Passwords
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_google_app_password_here
MAIL_DEFAULT_SENDER=your_email@gmail.com

# Option B: Resend API (Alternative email delivery service)
# Get your key at: https://resend.com
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev
